{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
	"logo": {
		"type": "small",
		"padding": {
			"top": 1	
		},
		"color": {
			"1": "magenta",
			"2": "magenta"
		}
	},
	"display": {
		"color": {
			"keys": "magenta",
			"title": "magenta"
		}
	},
	"modules": [
		"break",
		"title",
		{
			"type": "os",
			"key": "os"
		},
		{
			"type": "wm",
			"key": "wm"
		},
		{
			"type": "terminal",
			"key": "term"
		},
		{
			"type": "shell",
			"key": "shell"
		},

		"break",

